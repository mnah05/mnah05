---
import { getCollection, render } from "astro:content";
import NotesLayout from "../../components/NotesLayout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("notes");
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<NotesLayout title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} heroImage={post.data.heroImage} slug={post.id}>
	<Content />
</NotesLayout>
