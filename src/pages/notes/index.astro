---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import "../../styles/home.css";

const posts = (await getCollection("notes")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

let lastYear: number | null = null;
const viewSlugs = posts.map((post) => post.id);
---

<BaseLayout title="Notes | hasan" description="Short notes and write-ups from Hasan." path="/notes">
	<main>
		{posts.length === 0 ? <p>Brewing new notes soon.</p> : <ul class="index-list">{posts.map((post) => {
			const year = post.data.pubDate.getFullYear();
			const showYear = year !== lastYear;
			lastYear = year;
			return (
				<li class="group">
					<a href={`/notes/${post.id}`}>
						<span class="index-row">
							{showYear ? (
								<span class="index-year">{year}</span>
								<span class="index-title-wrap"><span class="index-title">{post.data.title}</span></span>
							) : (
								<span class="index-row-indented index-title-wrap"><span class="index-title">{post.data.title}</span></span>
							)}
							<span class="index-views" data-view-count={post.id}>—</span>
						</span>
					</a>
				</li>
			);
		})}</ul>}
	</main>
	<script define:vars={{ viewSlugs }}>
		(async () => {
			try {
				const res = await fetch(`/api/views?slugs=${encodeURIComponent(viewSlugs.join(","))}`);
				if (!res.ok) return;
				const data = await res.json();
				for (const el of document.querySelectorAll("[data-view-count]")) {
					const slug = el.getAttribute("data-view-count");
					const count = data.views?.[slug];
					if (typeof count === "number") el.textContent = count.toLocaleString("en-US");
				}
			} catch {
				/* best-effort */
			}
		})();
	</script>
</BaseLayout>
