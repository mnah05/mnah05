---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { resume } from "../data/resume";
import "../styles/resume.css";
---

<BaseLayout title="Resume | hasan" description={`${resume.name} — resume`} path="/resume">
	<main class="resume-page">
		<header class="resume-header"><div class="resume-header-top"><h1>{resume.name}</h1><div class="resume-actions"><a class="resume-print-btn" href="/resume.pdf" download="Md-Nauman-Athar-Hasan-Resume.pdf"><Icon name="download" /><span>Download PDF</span></a><button type="button" class="resume-print-btn" data-print-resume aria-label="Print resume"><Icon name="print" /><span>Print</span></button></div></div><div class="resume-contact"><span>{resume.location}</span><span class="sep">&bull;</span><a href={`mailto:${resume.email}`}>{resume.email}</a>{resume.links.map((link) => <span><span class="sep">&bull;</span><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></span>)}</div></header>
		<section class="resume-section"><h2>Education</h2>{resume.education.map((edu) => <div class="resume-entry"><div class="resume-entry-head"><h3>{edu.school}</h3><span class="year">{edu.years}</span></div><div class="resume-subline">{edu.degree} &mdash; {edu.location}</div>{edu.coursework && <ul class="resume-bullets"><li>Relevant Coursework: {edu.coursework}</li></ul>}</div>)}</section>
		<section class="resume-section"><h2>Projects</h2>{resume.projects.map((project) => <div class="resume-entry"><div class="resume-entry-head"><h3>{project.name}</h3><span class="year">{project.year}</span></div><div class="resume-subline"><span class="resume-project-tech">{project.tech}</span>{project.link && <a class="resume-project-link" href={project.link.href} target={project.link.href.startsWith("/") ? undefined : "_blank"} rel={project.link.href.startsWith("/") ? undefined : "noopener noreferrer"}>{project.link.label} &rarr;</a>}</div><ul class="resume-bullets">{project.points.map((point) => <li>{point}</li>)}</ul></div>)}</section>
		<section class="resume-section"><h2>Technical Skills</h2><div class="resume-skills-card">{resume.skills.map((skill) => <div class="skill-row"><span class="skill-category">{skill.category}</span><div class="skill-tags">{skill.items.split(", ").map((item) => <span class="skill-tag">{item}</span>)}</div></div>)}</div></section>
	</main>
</BaseLayout>

<script>
	document.querySelector<HTMLButtonElement>("[data-print-resume]")?.addEventListener("click", () => window.print());
</script>
