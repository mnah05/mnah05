---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--cursor-bg: #0a0a0b;
				--cursor-fg: #f5f5f7;
				--cursor-muted: #6b6b70;
				--cursor-border: #1f1f23;
				--cursor-accent: #65a30d;
				--cursor-hover: #84cc16;
			}
			body {
				background: var(--cursor-bg);
				color: var(--cursor-fg);
				font-family: "Atkinson", ui-monospace, monospace;
			}
			a { color: var(--cursor-fg); }
			::selection { background: rgba(101, 163, 13, 0.3); }
		</style>
	</head>
	<body>
		<main class="home">
			<h1>mnah</h1>
			<p class="tagline">builds things</p>

			<ul class="links">
				<li><a href="https://github.com/mnah05/kv" target="_blank" rel="noopener noreferrer">kv</a></li>
				<li><a href="https://github.com/mnah05/go-analytics" target="_blank" rel="noopener noreferrer">go-analytics</a></li>
				<li><a href="https://github.com/mnah05/boiler-go" target="_blank" rel="noopener noreferrer">boiler-go</a></li>
				<li><a href="https://github.com/mnah05/tripnest" target="_blank" rel="noopener noreferrer">tripnest</a></li>
				<li><a href="https://github.com/mnah05/dotfiles" target="_blank" rel="noopener noreferrer">dotfiles</a></li>
				<li><a href="https://raindrop.io/workwithnauman/reads-72899412" target="_blank" rel="noopener noreferrer">read</a></li>
				<li><a href="https://drive.google.com/file/d/1gUsJzs93HxYxz3EQhQPpnsIAQC58hEAC/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="resume">resume</a></li>
			</ul>

			<div class="social">
				<a href="https://github.com/mnah05/" target="_blank" rel="noopener noreferrer">gh</a>
				<a href="https://x.com/mnah05" target="_blank" rel="noopener noreferrer">x</a>
				<a href="https://www.linkedin.com/in/nauman-hasan-53a66630a/" target="_blank" rel="noopener noreferrer">in</a>
			</div>
		</main>

		<style>
			.home {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				padding: 2em 1em;
				text-align: center;
			}
			h1 {
				font-size: 4em;
				margin: 0;
				line-height: 1;
				letter-spacing: -0.03em;
				font-weight: 700;
				color: #fafafa;
			}
			.tagline {
				color: var(--cursor-muted);
				margin: 0.5em 0 2.5em;
				font-size: 1.2em;
			}
			.links {
				list-style: none;
				padding: 0;
				margin: 0 0 3em;
				display: flex;
				flex-direction: column;
				gap: 0.4em;
			}
			.links a {
				color: var(--cursor-fg);
				text-decoration: none;
				font-size: 1.1em;
				padding: 0.3em 0.6em;
				display: inline-block;
				border-bottom: 1px solid transparent;
				transition: all 0.15s;
			}
			.links a:hover {
				color: var(--cursor-accent);
				border-bottom-color: var(--cursor-accent);
			}
			.resume {
				color: var(--cursor-accent) !important;
			}
			.resume:hover {
				color: var(--cursor-hover) !important;
				border-bottom-color: var(--cursor-hover) !important;
			}
			.social {
				display: flex;
				gap: 1.5em;
			}
			.social a {
				color: var(--cursor-muted);
				text-decoration: none;
				font-size: 0.9em;
				transition: color 0.15s;
			}
			.social a:hover {
				color: var(--cursor-accent);
			}
		</style>
	</body>
</html>
