---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main class="home">
			<section class="hero">
				<h1>mnah</h1>
				<p class="tagline">builds things</p>
				<div class="hero-social">
					<a href="https://github.com/mnah05/" class="social-link">
						<svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
						<span>gh/mnah05</span>
					</a>
					<a href="https://x.com/mnah05" class="social-link">
						<svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor"><path d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"/></svg>
						<span>x/mnah05</span>
					</a>
					<a href="https://www.linkedin.com/in/nauman-hasan-53a66630a/" class="social-link">
						<svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/></svg>
						<span>linkedin</span>
					</a>
					<a href="https://drive.google.com/file/d/1byWcyyYyB5oBBgCvR-2UBQ_ahediKau9/view?usp=sharing" class="social-link resume">
						<span>resume</span>
					</a>
				</div>
			</section>

			<section class="projects">
				<h2>projects</h2>
				<div class="project-grid">
					<a href="https://github.com/mnah05/kv" class="project-card">
						<div class="project-header">
							<span class="project-name">kv</span>
							<span class="project-lang">Go</span>
						</div>
						<p class="project-desc">KV store with write-ahead log</p>
						<div class="project-footer">
							<span class="project-stars">* 1</span>
						</div>
					</a>

					<a href="https://github.com/mnah05/go-analytics" class="project-card">
						<div class="project-header">
							<span class="project-name">go-analytics</span>
							<span class="project-lang">Go</span>
						</div>
						<p class="project-desc">Privacy-focused web analytics built with Go</p>
						<div class="project-footer">
							<span class="project-stars">* 0</span>
						</div>
					</a>

					<a href="https://github.com/mnah05/boiler-go" class="project-card">
						<div class="project-header">
							<span class="project-name">boiler-go</span>
							<span class="project-lang">Go</span>
						</div>
						<p class="project-desc">Go backend starter. Clean architecture, PostgreSQL, Redis, background jobs.</p>
						<div class="project-footer">
							<span class="project-stars">* 0</span>
						</div>
					</a>

					<a href="https://github.com/mnah05/tripnest" class="project-card">
						<div class="project-header">
							<span class="project-name">tripnest</span>
							<span class="project-lang">JavaScript</span>
						</div>
						<p class="project-desc">Travel planning app</p>
						<div class="project-footer">
							<span class="project-stars">* 0</span>
						</div>
					</a>

					<a href="https://github.com/mnah05/dotfiles" class="project-card">
						<div class="project-header">
							<span class="project-name">dotfiles</span>
							<span class="project-lang">Shell</span>
						</div>
						<p class="project-desc">Personal dotfiles and dev environment config</p>
						<div class="project-footer">
							<span class="project-stars">* 0</span>
						</div>
					</a>
				</div>
			</section>
		</main>

		<style>
			.home {
				max-width: 800px;
				margin: 0 auto;
				padding: 4em 1.5em;
			}

			.hero {
				text-align: center;
				margin-bottom: 4em;
			}

			h1 {
				font-size: 4.5em;
				margin: 0;
				letter-spacing: -0.03em;
				background: linear-gradient(135deg, var(--accent), #ff4d4d);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}

			.tagline {
				color: rgb(var(--gray));
				font-size: 1.3em;
				margin: 0.3em 0 1.5em;
			}

			.hero-social {
				display: flex;
				justify-content: center;
				gap: 1.5em;
				flex-wrap: wrap;
			}

			.social-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				color: rgb(var(--gray));
				text-decoration: none;
				font-size: 0.9em;
				padding: 0.4em 0.8em;
				border-radius: 8px;
				transition: all 0.2s;
				background: rgb(var(--gray-light), 0.3);
			}

			.social-link:hover {
				color: var(--accent);
				background: rgb(var(--gray-light), 0.8);
			}

			.resume {
				background: var(--accent);
				color: white !important;
			}

			.resume:hover {
				background: var(--accent-dark) !important;
			}

			.projects h2 {
				font-size: 1.2em;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin-bottom: 1.5em;
				text-align: center;
			}

			.project-grid {
				display: flex;
				flex-direction: column;
				gap: 0.75em;
			}

			.project-card {
				display: block;
				padding: 1.25em 1.5em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				text-decoration: none;
				color: inherit;
				transition: all 0.2s;
				background: white;
			}

			.project-card:hover {
				border-color: var(--accent);
				box-shadow: 0 4px 20px rgba(var(--accent), 0.1);
				transform: translateY(-2px);
			}

			.project-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.4em;
			}

			.project-name {
				font-weight: 700;
				font-size: 1.1em;
				color: rgb(var(--black));
			}

			.project-lang {
				font-size: 0.8em;
				color: rgb(var(--gray));
				background: rgb(var(--gray-light));
				padding: 0.2em 0.6em;
				border-radius: 4px;
			}

			.project-desc {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
				line-height: 1.5;
			}

			.project-footer {
				margin-top: 0.6em;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}

			@media (max-width: 720px) {
				.home { padding: 2em 1em; }
				h1 { font-size: 3em; }
			}
		</style>
	</body>
</html>
