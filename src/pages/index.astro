---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { PROJECTS } from "../data/projects";
import "../styles/home.css";

type IndexItem = {
	year: number;
	title: string;
	href: string;
	viewSlug: string;
	kind: string;
	sortTime: number;
};

const notes = await getCollection("notes");

const noteItems: IndexItem[] = notes.map((post) => ({
	year: post.data.pubDate.getFullYear(),
	title: post.data.title,
	href: `/notes/${post.id}`,
	viewSlug: post.id,
	kind: "note",
	sortTime: post.data.pubDate.valueOf(),
}));

const projectItems: IndexItem[] = PROJECTS.map((project) => ({
	year: project.year,
	title: project.name,
	href: `/projects/${project.slug}`,
	viewSlug: `projects/${project.slug}`,
	kind: "project",
	// Projects only carry a year, so pin them to Jan 1 — notes with real
	// dates in the same year naturally sort above them (newest first).
	sortTime: new Date(project.year, 0, 1).valueOf(),
}));

const items = [...noteItems, ...projectItems].sort((a, b) => b.sortTime - a.sortTime || b.year - a.year);

let lastYear: number | null = null;
const viewSlugs = items.map((item) => item.viewSlug);
---

<BaseLayout title="hasan" description="The personal website of Md Nauman Athar Hasan: projects and notes." path="/">
	<main>
		<ul class="index-list">
			{items.map((item) => {
				const showYear = item.year !== lastYear;
				lastYear = item.year;
				return (
					<li class="group">
						<a href={item.href}>
							<span class="index-row">
								{showYear ? (
									<span class="index-year">{item.year}</span>
									<span class="index-title-wrap"><span class="index-title">{item.title}</span><span class="index-kind">{item.kind}</span></span>
								) : (
									<span class="index-row-indented index-title-wrap"><span class="index-title">{item.title}</span><span class="index-kind">{item.kind}</span></span>
								)}
								<span class="index-views" data-view-count={item.viewSlug}>—</span>
							</span>
						</a>
					</li>
				);
			})}
		</ul>
	</main>
	<script define:vars={{ viewSlugs }}>
		(async () => {
			const els = [...document.querySelectorAll("[data-view-count]")];
			if (els.length === 0) return;
			try {
				const res = await fetch(`/api/views?slugs=${encodeURIComponent(viewSlugs.join(","))}`);
				if (!res.ok) return;
				const data = await res.json();
				for (const el of els) {
					const slug = el.getAttribute("data-view-count");
					const count = data.views?.[slug];
					if (typeof count === "number") el.textContent = count.toLocaleString("en-US");
				}
			} catch {
				/* views are best-effort */
			}
		})();
	</script>
</BaseLayout>
