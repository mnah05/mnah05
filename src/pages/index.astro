---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { PROJECTS } from "../data/projects";
import "../styles/home.css";

type IndexItem = {
	year: number;
	title: string;
	href: string;
	viewSlug: string;
	sortTime: number;
};

const notes = await getCollection("notes");

const noteItems: IndexItem[] = notes.map((post) => ({
	year: post.data.pubDate.getFullYear(),
	title: post.data.title,
	href: `/notes/${post.id}`,
	viewSlug: post.id,
	sortTime: post.data.pubDate.valueOf(),
}));

const projectItems: IndexItem[] = PROJECTS.map((project) => ({
	year: project.year,
	title: project.name,
	href: `/projects/${project.slug}`,
	viewSlug: `projects/${project.slug}`,
	sortTime: new Date(project.year, 0, 1).valueOf(),
}));

const sortItems = (items: IndexItem[]) => [...items].sort((a, b) => b.sortTime - a.sortTime || b.year - a.year);
const projects = sortItems(projectItems);
const sortedNotes = sortItems(noteItems);
const viewSlugs = [...projects, ...sortedNotes].map((item) => item.viewSlug);
---

<BaseLayout title="hasan" description="The personal website of Md Nauman Athar Hasan: projects and notes." path="/">
	<main>
		<section class="home-section" aria-labelledby="projects-heading">
			<div class="section-heading"><h1 id="projects-heading">Projects</h1><a href="/projects">All projects</a></div>
			<div class="project-card-list">{PROJECTS.map((project) => <ProjectCard project={project} />)}</div>
		</section>
		<section class="home-section" aria-labelledby="notes-heading">
			<div class="section-heading"><h1 id="notes-heading">Notes</h1><a href="/notes">All notes</a></div>
			{sortedNotes.length === 0 ? <p>Brewing new notes soon.</p> : <ul class="index-list">
				{sortedNotes.map((item, index) => {
					const showYear = index === 0 || item.year !== sortedNotes[index - 1].year;
					return <li class="group"><a href={item.href}><span class="index-row">{showYear ? <span class="index-year">{item.year}</span> : null}<span class:list={{ "index-title-wrap": true, "index-row-indented": !showYear }}><span class="index-title">{item.title}</span></span><span class="index-views" data-view-count={item.viewSlug}>—</span></span></a></li>;
				})}
			</ul>}
		</section>
	</main>
	<script define:vars={{ viewSlugs }}>
		const loadViewCounts = async () => {
			const els = [...document.querySelectorAll("[data-view-count]")];
			if (els.length === 0) return;
			try {
				const res = await fetch(`/api/views?slugs=${encodeURIComponent(viewSlugs.join(","))}`);
				if (!res.ok) return;
				const data = await res.json();
				for (const el of els) {
					const slug = el.getAttribute("data-view-count");
					const count = data.views?.[slug];
					if (typeof count === "number") el.textContent = count.toLocaleString("en-US");
				}
			} catch {
				/* views are best-effort */
			}
		};
		if ("requestIdleCallback" in window) window.requestIdleCallback(loadViewCounts, { timeout: 1500 });
		else window.setTimeout(loadViewCounts, 0);
	</script>
</BaseLayout>
