---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--cursor-bg: #0a0a0b;
				--cursor-fg: #e1e1e3;
				--cursor-muted: #6b6b70;
				--cursor-border: #1f1f23;
				--cursor-accent: #65a30d;
				--cursor-hover: #84cc16;
			}
			body {
				background: var(--cursor-bg);
				color: var(--cursor-fg);
				font-family: "Atkinson", ui-monospace, monospace;
			}
			a { color: var(--cursor-fg); }
			::selection { background: rgba(101, 163, 13, 0.3); }
		</style>
	</head>
	<body>
		<main class="home">
			<h1>mnah</h1>
			<p class="tagline">builds things</p>

			<div id="now-playing" class="now-playing hidden">
				<div class="np-indicator">
					<span class="np-dot"></span>
					<span class="np-label">now playing</span>
				</div>
				<a id="np-link" href="#" target="_blank" rel="noopener noreferrer">
					<img id="np-img" src="" alt="" width="40" height="40" />
					<div class="np-info">
						<span id="np-title"></span>
						<span id="np-artist" class="np-artist"></span>
					</div>
				</a>
			</div>

			<div class="links">
				<a href="https://github.com/mnah05/kv">kv</a>
				<a href="https://github.com/mnah05/go-analytics">go-analytics</a>
				<a href="https://github.com/mnah05/boiler-go">boiler-go</a>
				<a href="https://github.com/mnah05/tripnest">tripnest</a>
				<a href="https://github.com/mnah05/dotfiles">dotfiles</a>
				<a href="https://drive.google.com/file/d/1byWcyyYyB5oBBgCvR-2UBQ_ahediKau9/view" class="resume">resume</a>
			</div>

			<div class="social">
				<a href="https://github.com/mnah05/">gh</a>
				<a href="https://x.com/mnah05">x</a>
				<a href="https://www.linkedin.com/in/nauman-hasan-53a66630a/">in</a>
			</div>
		</main>

		<style>
			.home {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				padding: 2em 1em;
				text-align: center;
			}
			h1 {
				font-size: 4em;
				margin: 0;
				line-height: 1;
				letter-spacing: -0.03em;
			}
			.tagline {
				color: var(--cursor-muted);
				margin: 0.5em 0 2em;
				font-size: 1.2em;
			}

			.now-playing {
				margin-bottom: 2.5em;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5em;
			}
			.now-playing.hidden { display: none; }
			.np-indicator {
				display: flex;
				align-items: center;
				gap: 0.4em;
				font-size: 0.75em;
				color: var(--cursor-accent);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.np-dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--cursor-accent);
				animation: np-pulse 1.5s ease-in-out infinite;
			}
			@keyframes np-pulse {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.4; transform: scale(0.8); }
			}
			.now-playing a {
				display: flex;
				align-items: center;
				gap: 0.75em;
				text-decoration: none;
				color: var(--cursor-fg);
				padding: 0.5em 1em;
				border: 1px solid var(--cursor-border);
				border-radius: 8px;
				transition: all 0.15s;
			}
			.now-playing a:hover {
				border-color: var(--cursor-accent);
				background: rgba(101, 163, 13, 0.05);
			}
			.now-playing img {
				border-radius: 4px;
				width: 40px;
				height: 40px;
				object-fit: cover;
			}
			.np-info {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				text-align: left;
			}
			.np-info span:first-child {
				font-size: 0.9em;
				font-weight: 600;
			}
			.np-artist {
				font-size: 0.8em;
				color: var(--cursor-muted);
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em 1.5em;
				justify-content: center;
				max-width: 600px;
				margin-bottom: 3em;
			}
			.links a {
				color: var(--cursor-fg);
				text-decoration: none;
				font-size: 1em;
				padding: 0.2em 0.4em;
				border-bottom: 1px solid transparent;
				transition: all 0.15s;
			}
			.links a:hover {
				color: var(--cursor-accent);
				border-bottom-color: var(--cursor-accent);
			}
			.resume {
				color: var(--cursor-accent) !important;
			}
			.resume:hover {
				color: var(--cursor-hover) !important;
				border-bottom-color: var(--cursor-hover) !important;
			}
			.social {
				display: flex;
				gap: 1.5em;
			}
			.social a {
				color: var(--cursor-muted);
				text-decoration: none;
				font-size: 0.9em;
				transition: color 0.15s;
			}
			.social a:hover {
				color: var(--cursor-accent);
			}
		</style>

		<script>
			async function fetchNowPlaying() {
				try {
					const res = await fetch("/api/now-playing");
					const data = await res.json();
					const el = document.getElementById("now-playing");
					if (!data.isPlaying) {
						el?.classList.add("hidden");
						return;
					}
					el?.classList.remove("hidden");
					document.getElementById("np-title")!.textContent = data.title;
					document.getElementById("np-artist")!.textContent = data.artist;
					document.getElementById("np-link")!.href = data.songUrl;
					const img = document.getElementById("np-img") as HTMLImageElement;
					img.src = data.albumImage;
					img.alt = data.album;
				} catch {
					document.getElementById("now-playing")?.classList.add("hidden");
				}
			}
			fetchNowPlaying();
			setInterval(fetchNowPlaying, 30000);
		</script>
	</body>
</html>
