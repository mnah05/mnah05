---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main class="home">
			<h1>mnah</h1>
			<p class="tagline">builds things</p>

			<div class="links">
				<a href="https://github.com/mnah05/boiler-go">boiler-go</a>
				<a href="https://github.com/mnah05/go-analytics">go-analytics</a>
				<a href="https://github.com/mnah05/kv">kv</a>
				<a href="https://github.com/mnah05/map-reduce">map-reduce</a>
				<a href="https://github.com/mnah05/MessageQueue">MessageQueue</a>
				<a href="https://github.com/mnah05/learn-kafka">learn-kafka</a>
				<a href="https://github.com/mnah05/tripnest">tripnest</a>
				<a href="https://github.com/mnah05/neetcode-submissions">neetcode-submissions</a>
				<a href="https://github.com/mnah05/dotfiles">dotfiles</a>
				<a href="https://github.com/mnah05/ws-scale">ws-scale</a>
				<a href="/blog">blog</a>
			</div>

			<div class="social">
				<a href="https://github.com/mnah05/">gh</a>
				<a href="https://x.com/mnah05">x</a>
				<a href="https://www.linkedin.com/in/nauman-hasan-53a66630a/">in</a>
			</div>
		</main>

		<style>
			.home {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				padding: 2em 1em;
				text-align: center;
			}
			h1 {
				font-size: 4em;
				margin: 0;
				line-height: 1;
			}
			.tagline {
				color: rgb(var(--gray));
				margin: 0.5em 0 2em;
				font-size: 1.2em;
			}
			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em 1.5em;
				justify-content: center;
				max-width: 600px;
				margin-bottom: 3em;
			}
			.links a {
				color: rgb(var(--gray-dark));
				text-decoration: none;
				font-size: 1em;
			}
			.links a:hover {
				color: var(--accent);
			}
			.social {
				display: flex;
				gap: 1.5em;
			}
			.social a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.social a:hover {
				color: var(--accent);
			}
		</style>
	</body>
</html>
