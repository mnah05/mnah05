---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ViewCounter from "../../components/ViewCounter.astro";
import { PROJECTS } from "../../data/projects";
import "../../styles/project.css";

export function getStaticPaths() {
	return PROJECTS.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const viewSlug = `projects/${project.slug}`;
---

<BaseLayout title={`${project.name} | hasan`} description={project.short} path={`/projects/${project.slug}`}>
	<main class="project-page"><article>
		<h1>{project.name}</h1>
		<div class="project-meta-line">
			<a href="https://x.com/mnah05" target="_blank" rel="noopener noreferrer">@mnah05</a>
			<span>|</span>
			<span>{project.year}</span>
			<span>|</span>
			<span><ViewCounter slug={viewSlug} /></span>
			<span>|</span>
			<span>{project.status.label}</span>
		</div>
		<p class="project-tagline">{project.tagline}</p>
		<p class="status-note">{project.status.note}</p>
		<div class="project-body">
			{project.summary.map((paragraph) => <p>{paragraph}</p>)}
			<h2>What it does</h2>
			<ul class="project-highlights">{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
			<h2>Built with</h2>
			<ul class="project-stack">{project.stack.map((tool) => <li>{tool}</li>)}</ul>
		</div>
		<div class="project-actions">
			{project.liveUrl && <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">View live site</a>}
			{project.github?.url ? <a href={project.github.url} target="_blank" rel="noopener noreferrer">View on GitHub</a> : <a href="https://github.com/mnah05" target="_blank" rel="noopener noreferrer">GitHub</a>}
		</div>
		{project.github?.note && <p class="status-note">{project.github.note}</p>}
	</article></main>
</BaseLayout>
