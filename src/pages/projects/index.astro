---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { PROJECTS } from "../../data/projects";
import "../../styles/home.css";

const projects = [...PROJECTS].sort((a, b) => b.year - a.year);

const viewSlugs = projects.map((project) => `projects/${project.slug}`);
---

<BaseLayout title="Projects | hasan" description="A selection of projects by Hasan" path="/projects">
	<main>
		<div class="project-card-list">{projects.map((project) => <ProjectCard project={project} />)}</div>
	</main>
	<script define:vars={{ viewSlugs }}>
		const loadViewCounts = async () => {
			try {
				const res = await fetch(`/api/views?slugs=${encodeURIComponent(viewSlugs.join(","))}`);
				if (!res.ok) return;
				const data = await res.json();
				for (const el of document.querySelectorAll("[data-view-count]")) {
					const slug = el.getAttribute("data-view-count");
					const count = data.views?.[slug];
					if (typeof count === "number") el.textContent = count.toLocaleString("en-US");
				}
			} catch {
				/* best-effort */
			}
		};
		if ("requestIdleCallback" in window) window.requestIdleCallback(loadViewCounts, { timeout: 1500 });
		else window.setTimeout(loadViewCounts, 0);
	</script>
</BaseLayout>
