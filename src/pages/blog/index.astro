---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getCollection } from "astro:content";
import "../../styles/blog-index.css";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog | hasan" description="Thoughts, notes, and write-ups from Hasan.">
	<main class="blog-index-page"><section>
		<div class="blog-header"><h1>Writing &amp; Notes</h1><p class="blog-subtitle">Thoughts on backend systems, Go, TypeScript, Cloudflare, and developer craft.</p></div>
		{posts.length === 0 ? <div class="empty-state"><span class="empty-icon">☕</span><p>Brewing new articles soon. Stay tuned!</p></div> : <ul class="post-list">{posts.map((post) => <li><a href={`/blog/${post.id}`} class="post-item-link"><div class="post-item-header"><h2 class="title">{post.data.title}</h2><span class="post-arrow" aria-hidden="true">&rarr;</span></div>{post.data.description && <p class="post-description">{post.data.description}</p>}<div class="post-meta"><span class="date"><FormattedDate date={post.data.pubDate} /></span><span class="view-count" data-view-count={post.id}>— views</span></div></a></li>)}</ul>}
	</section></main>
	<script>
		const els = [...document.querySelectorAll("[data-view-count]")] as HTMLElement[];
		if (els.length > 0) {
			const slugs = els.map((el) => el.dataset.viewCount as string).filter(Boolean);
			const fmt = (n: number) => (n === 1 ? "1 view" : `${n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k` : n} views`);
			fetch(`/api/views?slugs=${encodeURIComponent(slugs.join(","))}`)
				.then((res) => (res.ok ? res.json() : null))
				.then((data: { views?: Record<string, number> } | null) => {
					if (!data?.views) return;
					for (const el of els) {
						const slug = el.dataset.viewCount as string;
						el.textContent = fmt(data.views[slug] ?? 0);
					}
				})
				.catch(() => {});
		}
	</script>
	<style>
		.view-count {
			color: var(--muted);
			font-size: 0.85em;
			font-variant-numeric: tabular-nums;
		}
	</style>
</BaseLayout>
