---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getCollection } from "astro:content";
import "../../styles/blog-index.css";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog | hasan" description="Thoughts, notes, and write-ups from Hasan.">
	<main class="blog-index-page"><section>
		<div class="blog-header"><h1>Writing &amp; Notes</h1><p class="blog-subtitle">Thoughts on backend systems, Go, TypeScript, Cloudflare, and developer craft.</p></div>
		{posts.length === 0 ? <div class="empty-state"><span class="empty-icon">☕</span><p>Brewing new articles soon. Stay tuned!</p></div> : <ul class="post-list">{posts.map((post) => <li><a href={`/blog/${post.id}`} class="post-item-link"><div class="post-item-header"><h2 class="title">{post.data.title}</h2><span class="post-arrow" aria-hidden="true">&rarr;</span></div>{post.data.description && <p class="post-description">{post.data.description}</p>}<div class="post-meta"><span class="date"><FormattedDate date={post.data.pubDate} /></span></div></a></li>)}</ul>}
	</section></main>
</BaseLayout>
