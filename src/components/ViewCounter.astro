---
interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

<span class="view-counter" data-view-counter data-slug={slug} aria-live="polite"><span data-view-num>—</span>&nbsp;views</span>

<script>
	import { formatViews } from "../scripts/views";

	const els = document.querySelectorAll("[data-view-counter]");
	els.forEach(async (el) => {
		const slug = (el as HTMLElement).dataset.slug;
		const num = el.querySelector("[data-view-num]");
		if (!slug || !num) return;
		const renderFull = (n: number) => n.toLocaleString("en-US");
		try {
			const key = `viewed:${slug}`;
			let seen: string | null = null;
			try {
				seen = localStorage.getItem(key);
			} catch {
				seen = null;
			}
			if (seen) {
				const res = await fetch(`/api/views/${encodeURIComponent(slug)}`);
				if (res.ok) num.textContent = renderFull(((await res.json()) as { views: number }).views ?? 0);
				return;
			}
			const res = await fetch(`/api/views/${encodeURIComponent(slug)}`, { method: "POST" });
			if (!res.ok) return;
			const data = (await res.json()) as { views: number };
			num.textContent = renderFull(data.views ?? 0);
			try {
				localStorage.setItem(key, "1");
			} catch {
				// private mode etc. — server-side dedup still holds
			}
		} catch {
			el.remove();
		}
	});
</script>

<style>
	.view-counter {
		color: inherit;
		font-variant-numeric: tabular-nums;
	}
</style>
