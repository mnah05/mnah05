---
interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

<span class="view-counter" data-view-counter data-slug={slug} aria-live="polite">
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
	<span data-view-num>—</span>&nbsp;views
</span>

<script>
	const els = document.querySelectorAll("[data-view-counter]");
	els.forEach(async (el) => {
		const slug = (el as HTMLElement).dataset.slug;
		const num = el.querySelector("[data-view-num]");
		if (!slug || !num) return;
		const fmt = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k` : `${n}`);
		try {
			// Unique-only: count once per browser persistently. Server also
			// dedups by visitor hash, this just avoids repeat POSTs
			// (and stays well within D1's free write limits).
			const key = `viewed:${slug}`;
			let seen: string | null = null;
			try {
				seen = localStorage.getItem(key);
			} catch {
				seen = null;
			}
			if (seen) {
				const res = await fetch(`/api/views/${encodeURIComponent(slug)}`);
				if (res.ok) num.textContent = fmt(((await res.json()) as { views: number }).views ?? 0);
				return;
			}
			const res = await fetch(`/api/views/${encodeURIComponent(slug)}`, { method: "POST" });
			if (!res.ok) return;
			const data = (await res.json()) as { views: number };
			num.textContent = fmt(data.views ?? 0);
			try {
				localStorage.setItem(key, "1");
			} catch {
				// private mode etc. — server-side dedup still holds
			}
		} catch {
			// Views are best-effort; never break the page.
			el.remove();
		}
	});
</script>

<style>
	.view-counter {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.85em;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.view-counter svg {
		flex: none;
	}
</style>
