---
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "./FormattedDate.astro";
import ViewCounter from "./ViewCounter.astro";
import "../styles/notes-post.css";

interface Props {
	title: string;
	description: string;
	pubDate: string | Date;
	updatedDate?: string | Date;
	heroImage?: string;
	slug?: string;
}

const { title, description, pubDate, updatedDate, heroImage, slug } = Astro.props;
const path = slug ? `/notes/${slug}` : undefined;
---

<BaseLayout title={title} description={description} path={path} image={heroImage}>
	<main class="notes-post-page">
		<article class="post-article">
			<h1>{title}</h1>
			<div class="post-meta-line">
				<a href="https://x.com/mnah05" target="_blank" rel="noopener noreferrer">@mnah05</a>
				<span>|</span>
				<FormattedDate date={pubDate} />
				{updatedDate && <span>(Updated <FormattedDate date={updatedDate} />)</span>}
				{slug && <span><ViewCounter slug={slug} /></span>}
			</div>
			{heroImage && <div class="hero-image"><img width="1020" height="510" src={heroImage} alt="" /></div>}
			<div class="post-content"><slot /></div>
		</article>
	</main>
</BaseLayout>
