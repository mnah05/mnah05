---
const SITE_TITLE = "hasan";
---

<header class="site-header">
	<nav>
		<a href="/" class="brand"><span class="brand-text">{SITE_TITLE}</span><span class="caret" aria-hidden="true"></span></a>
		<div class="nav-links">
			<a href="/notes">Notes</a>
			<a href="/about">About</a>
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
				<span class="icon-stack" aria-hidden="true">
					<svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13.5A8 8 0 0 1 10.5 4 6.5 6.5 0 1 0 20 13.5Z" /></svg>
					<svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
				</span>
			</button>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById("theme-toggle");
	const meta = document.getElementById("meta-theme-color");
	const media = window.matchMedia("(prefers-color-scheme: dark)");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	function currentTheme() {
		return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
	}

	function syncButton(theme) {
		if (!toggle) return;
		const isDark = theme === "dark";
		toggle.setAttribute("aria-pressed", isDark ? "true" : "false");
		toggle.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
	}

	function applyTheme(theme) {
		if (theme === "dark") document.documentElement.setAttribute("data-theme", "dark");
		else document.documentElement.removeAttribute("data-theme");
		if (meta) meta.setAttribute("content", theme === "dark" ? "#191410" : "#f5efe5");
		try {
			localStorage.setItem("theme", theme);
		} catch (e) {
			/* storage unavailable — theme still applies for this session */
		}
		syncButton(theme);
	}

	function flipTheme() {
		const next = currentTheme() === "dark" ? "light" : "dark";
		// Keep every themed property easing for the duration of the switch.
		document.documentElement.classList.add("theme-anim");
		window.setTimeout(() => document.documentElement.classList.remove("theme-anim"), 550);

		// Use View Transitions for a fluid cross-fade when available.
		const startTransition = document.startViewTransition?.bind(document);
		if (startTransition && !reduceMotion.matches) {
			startTransition(() => applyTheme(next));
		} else {
			applyTheme(next);
		}
	}

	syncButton(currentTheme());
	toggle?.addEventListener("click", flipTheme);

	// Follow the OS while the visitor has no saved choice.
	media.addEventListener?.("change", (event) => {
		let saved = null;
		try {
			saved = localStorage.getItem("theme");
		} catch (e) {
			/* ignore */
		}
		if (saved !== "light" && saved !== "dark") applyTheme(event.matches ? "dark" : "light");
	});
</script>
