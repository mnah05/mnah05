---
const SITE_TITLE = "hasan";
---

<header class="site-header">
	<nav>
		<a href="/" class="brand">{SITE_TITLE}</a>
		<div class="nav-links">
			<a href="/about"><span>About</span></a>
			<a href="/resume"><span>Resume</span></a>
			<a href="https://x.com/mnah05" target="_blank" rel="noopener noreferrer"><span><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg><span>Follow me</span></span></a>
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
				<span class="icon-stack" aria-hidden="true">
					<svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13.5A8 8 0 0 1 10.5 4 6.5 6.5 0 1 0 20 13.5Z" /></svg>
					<svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
				</span>
			</button>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById("theme-toggle");
	const meta = document.getElementById("meta-theme-color");
	const media = window.matchMedia("(prefers-color-scheme: dark)");

	function currentTheme() {
		return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
	}

	function syncButton(theme) {
		if (!toggle) return;
		const isDark = theme === "dark";
		toggle.setAttribute("aria-pressed", isDark ? "true" : "false");
		toggle.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
	}

	function applyTheme(theme) {
		if (theme === "dark") document.documentElement.setAttribute("data-theme", "dark");
		else document.documentElement.removeAttribute("data-theme");
		if (meta) meta.setAttribute("content", theme === "dark" ? "#0a0a0a" : "#ffffff");
		try {
			localStorage.setItem("theme", theme);
		} catch (e) {
			/* storage unavailable */
		}
		syncButton(theme);
	}

	toggle?.addEventListener("click", () => {
		applyTheme(currentTheme() === "dark" ? "light" : "dark");
	});

	syncButton(currentTheme());

	media.addEventListener?.("change", (event) => {
		let saved = null;
		try {
			saved = localStorage.getItem("theme");
		} catch (e) {
			/* ignore */
		}
		if (saved !== "light" && saved !== "dark") applyTheme(event.matches ? "dark" : "light");
	});
</script>
